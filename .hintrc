{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/aria": [
      "default",
      {
        "aria-valid-attr-value": "off"
      }
    ],
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "text-wrap",
          "text-wrap: balance"
        ]
      }
    ],
    "typescript-config/consistent-casing": "off",
    "axe/structure": [
      "default",
      {
        "list": "off"
      }
    ]
  }
}